  "definitions": {
    "Author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "example": "Miguel de Cervantes Saavedra"
        },
        "birthplace": {
          "type": "string",
          "x-nullable": true,
          "example": "Alcalá de Henares, Spain"
        },
        "birthDate": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true,
          "example": "1547-09-29"
        },
        "deathDate": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true,
          "example": "1616-04-22"
        },
        "topicIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "example": [
            "507f1f77bcf86cd799439013"
          ]
        }
      }
    },
    "Book": {
      "type": "object",
      "required": [
        "authorId",
        "title"
      ],
      "properties": {
        "authorId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "description": "ID of the author associated with this book.",
          "example": "507f1f77bcf86cd799439011"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "example": "Don Quixote"
        },
        "publicationDate": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true,
          "example": "1605-01-01"
        },
        "pageCount": {
          "type": "integer",
          "minimum": 0,
          "example": 950
        },
        "description": {
          "type": "string",
          "x-nullable": true,
          "example": "A would-be knight sets out with his squire, Sancho Panza."
        },
        "language": {
          "type": "string",
          "x-nullable": true,
          "example": "Spanish"
        },
        "topicId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "x-nullable": true,
          "example": "507f1f77bcf86cd799439013"
        }
      }
    },
    "Quote": {
      "type": "object",
      "required": [
        "bookId",
        "quote"
      ],
      "properties": {
        "bookId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "description": "ID of the book this quote comes from.",
          "example": "507f1f77bcf86cd799439012"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "example": "Freedom, Sancho, is one of the most precious gifts that heaven has bestowed upon men."
        },
        "context": {
          "type": "string",
          "x-nullable": true,
          "example": "Don Quixote speaks to Sancho about freedom in Part II, Chapter 58."
        },
        "topicIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "example": [
            "507f1f77bcf86cd799439013"
          ]
        }
      }
    },
    "Topic": {
      "type": "object",
      "required": [
        "_id",
        "name",
        "definition"
      ],
      "properties": {
        "_id": {
          "type": "string",
          "readOnly": true,
          "description": "MongoDB ID returned with the topic.",
          "example": "507f1f77bcf86cd799439013"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "example": "Freedom"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "example": "The ability to make choices and act without undue restraint."
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "example": "Invalid topic ID. Use a 24-character hexadecimal MongoDB ID."
        }
      }
    },
    "Message": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "example": "Topic not found"
        }
      }
    }
  }
}